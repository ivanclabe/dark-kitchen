{
  "version": 1,
  "notes": "ADR 0033, fase 4. role: self = quien corre la prueba (dueño o administrador); los demás son roles del sistema (el ejecutor usa x-dk-role-id). expect.scope admite varias respuestas válidas. truth: cifra que debe aparecer en la respuesta, calculada con el mismo RPC de datos y la sesión de quien corre la prueba. Marcadores de fecha: {today}, {yesterday}, {monday}, {month_start}, {last_month_start}, {last_month_end}, {d-30}. {last_order} = número del pedido más reciente.",
  "questions": [
    { "id": "s1", "role": "self", "q": "¿Cuánto vendimos hoy?", "expect": { "intent": ["sales"], "scope": ["answered", "no_data"] }, "truth": { "rpc": "dk_copilot_sales", "args": { "p_from": "{today}", "p_to": "{today}" }, "path": "total", "kind": "money" } },
    { "id": "s2", "role": "self", "q": "¿Cuánto vendimos ayer?", "expect": { "intent": ["sales"], "scope": ["answered", "no_data"] }, "truth": { "rpc": "dk_copilot_sales", "args": { "p_from": "{yesterday}", "p_to": "{yesterday}" }, "path": "total", "kind": "money" } },
    { "id": "s3", "role": "self", "q": "¿Cuántos pedidos tuvimos esta semana?", "expect": { "intent": ["sales", "orders"], "scope": ["answered", "no_data"] }, "truth": { "rpc": "dk_copilot_sales", "args": { "p_from": "{monday}", "p_to": "{today}" }, "path": "orders", "kind": "count" } },
    { "id": "s4", "role": "self", "q": "¿Cuál fue el ticket promedio de los últimos 30 días?", "expect": { "intent": ["sales"], "scope": ["answered", "no_data"] }, "truth": { "rpc": "dk_copilot_sales", "args": { "p_from": "{d-30}", "p_to": "{today}" }, "path": "avgTicket", "kind": "money" } },
    { "id": "s5", "role": "self", "q": "¿Vendimos más esta semana que la pasada?", "expect": { "intent": ["sales"], "scope": ["answered", "no_data"] } },
    { "id": "s6", "role": "self", "q": "¿Cuáles son los 5 platos más vendidos del mes?", "expect": { "intent": ["sales", "products"], "scope": ["answered", "no_data"] } },
    { "id": "s7", "role": "self", "q": "¿A qué hora vendemos más?", "expect": { "intent": ["sales"], "scope": ["answered", "no_data"] } },
    { "id": "s8", "role": "self", "q": "¿Cuánto vendimos el mes pasado por canal?", "expect": { "intent": ["sales"], "scope": ["answered", "no_data"] }, "truth": { "rpc": "dk_copilot_sales", "args": { "p_from": "{last_month_start}", "p_to": "{last_month_end}" }, "path": "total", "kind": "money" } },
    { "id": "o1", "role": "self", "q": "¿Qué pedidos hay por confirmar?", "expect": { "intent": ["orders"], "scope": ["answered", "no_data"] } },
    { "id": "o2", "role": "self", "q": "¿Qué pedidos de hoy se demoraron más de 30 minutos?", "expect": { "intent": ["orders", "kitchen"], "scope": ["answered", "no_data"] } },
    { "id": "o3", "role": "self", "q": "¿Cuántos pedidos se cancelaron este mes?", "expect": { "intent": ["orders"], "scope": ["answered", "no_data"] }, "truth": { "rpc": "dk_copilot_orders", "args": { "p_from": "{month_start}", "p_to": "{today}", "p_statuses": ["CANCELADO"] }, "path": "count", "kind": "count" } },
    { "id": "o4", "role": "self", "q": "¿Cuántos pedidos entregamos ayer?", "expect": { "intent": ["orders", "deliveries"], "scope": ["answered", "no_data"] }, "truth": { "rpc": "dk_copilot_orders", "args": { "p_from": "{yesterday}", "p_to": "{yesterday}", "p_statuses": ["ENTREGADO"] }, "path": "count", "kind": "count" } },
    { "id": "o5", "role": "self", "q": "¿Cuáles fueron los últimos pedidos por WhatsApp?", "expect": { "intent": ["orders"], "scope": ["answered", "no_data"] } },
    { "id": "o6", "role": "self", "q": "¿Hay pedidos listos esperando domiciliario?", "expect": { "intent": ["orders", "deliveries", "kitchen"], "scope": ["answered", "no_data"] } },
    { "id": "o7", "role": "self", "q": "¿Qué pidió el último cliente?", "expect": { "intent": ["orders", "order_detail"], "scope": ["answered", "no_data"] } },
    { "id": "d1", "role": "self", "q": "¿Cómo va el pedido {last_order}?", "expect": { "intent": ["order_detail", "orders"], "scope": ["answered"] } },
