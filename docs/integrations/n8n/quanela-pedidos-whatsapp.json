              "leftValue": "={{ $('Verificar firma').item.json.event }}",
              "rightValue": "whatsapp.message.received",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "¿Es un mensaje?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').item.json.supabaseUrl }}/auth/v1/token?grant_type=password",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Configuración').item.json.publishableKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { email: $env.QUANELA_SERVICE_EMAIL ?? 'usuario-servicio@tu-negocio.co', password: $env.QUANELA_SERVICE_PASSWORD } }}",
        "options": {}
      },
      "name": "Entrar (usuario de servicio)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "notes": "Usa un usuario de servicio con rol Caja, solo en esta cuenta. Mejor: guarda correo y contraseña como credencial de n8n."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').item.json.supabaseUrl }}/rest/v1/rpc/dk_public_menu",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Configuración').item.json.publishableKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { p_slug: $('Configuración').item.json.menuSlug } }}",
        "options": {}
      },
      "name": "Menú de hoy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aquí va tu lógica (o un agente de IA). Este ejemplo responde con el menú de hoy, con precios de Quanela.\nconst menu = $('Menú de hoy').first().json;\nconst msg = $('Verificar firma').first().json.data;\nconst items = (menu.items ?? []).filter((i) => i.availability === 'available');\nconst fmt = (n) => '$' + Math.round(n).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.');\nconst text = items.length\n  ? `Hola ${msg.name ?? ''}, hoy tenemos:\\n` + items.map((i) => `• ${i.name} — ${fmt(i.price)}`).join('\\n') + '\\n¿Qué te gustaría pedir?'\n  : 'Hola, hoy no tenemos platos disponibles.';\nreturn [{ json: { conversationId: msg.conversationId, wamid: msg.wamid, text } }];"
      },
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').item.json.supabaseUrl }}/rest/v1/rpc/dk_wa_send_text",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Configuración').item.json.publishableKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Entrar (usuario de servicio)').item.json.access_token }}"
            },
            {
              "name": "x-dk-kitchen-id",
              "value": "={{ $('Configuración').item.json.accountId }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { p_conversation_id: $json.conversationId, p_text: $json.text, p_take_over: false } }}",
        "options": {}
      },
      "name": "Responder por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        300
      ],
      "notes": "Quanela envía con el número y el token de la cuenta: n8n nunca tiene el token de Meta."
    },
    {
      "parameters": {
        "content": "## Crear el pedido\nCuando el cliente confirme, llama `dk_wa_place_order_for` con los mismos encabezados:\n```json\n{ \"p_conversation_id\": \"…\", \"p_order\": { \"idempotencyKey\": \"<wamid del «sí»>\", \"fulfillment\": \"delivery|pickup\", \"address\": \"…\", \"paymentMethod\": \"Efectivo\", \"items\": [{ \"productId\": \"…\", \"quantity\": 2, \"note\": \"sin cebolla\" }] } }\n```\nQuanela calcula precios, domicilio, mínimo y total, y lo envía a cocina con las reglas del menú público.",
        "height": 300,
        "width": 460
      },
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1760,
        480
      ]
    }
