        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Quanela firma cada evento: X-Quanela-Signature = \"sha256=\" + HMAC-SHA256(secreto, cuerpo).\n// Activa «Raw Body» en el nodo Webhook para comparar exactamente los bytes recibidos.\nconst crypto = require('crypto');\nconst cfg = $('Configuración').first().json;\nconst item = $input.first();\nconst raw = item.binary?.data ? Buffer.from(item.binary.data.data, 'base64').toString('utf8') : JSON.stringify(item.json.body);\nconst given = String(item.json.headers?.['x-quanela-signature'] ?? '');\nconst expected = 'sha256=' + crypto.createHmac('sha256', cfg.secret).update(raw).digest('hex');\nconst valid = given.length === expected.length && crypto.timingSafeEqual(Buffer.from(given), Buffer.from(expected));\nconst body = JSON.parse(raw);\nreturn [{ json: { valid, event: body.event, data: body.data, deliveryId: body.id, accountId: body.accountId } }];"
      },
      "name": "Verificar firma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
