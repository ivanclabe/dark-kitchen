{
  "$comment": "ADR 0034: the scenes of scripts/help-screenshots.ts. Each «annotate» number matches the note with the same number in the article. {VAR} in a path comes from QUANELA_HELP_<VAR> (ids of the DEMO business), so a capture never creates data.",
  "scenes": [
    { "id": "login", "path": "/login", "public": true, "waitFor": "Inicia sesión",
      "annotate": [{ "text": "Correo electrónico", "n": 1 }, { "selector": "section[aria-label='Entrar con el método con el que creaste tu negocio']", "n": 2 }] },
    { "id": "signup-methods", "path": "/registro", "public": true, "waitFor": "de 3", "crop": "div:has(> div.rounded-2xl:has(button:has-text('Continuar con email')))",
      "annotate": [{ "text": "de 3", "n": 1 }, { "selector": "div.space-y-2\\.5:has(button:has-text('Continuar con Google'))", "n": 2 }] },
    { "id": "home", "path": "/dashboard", "waitFor": "Ventas de hoy",
      "annotate": [{ "text": "Ventas de hoy", "n": 1 }, { "selector": "a[href$='/supply/compras']:visible", "n": 2 }, { "text": "Necesita atención", "n": 3 }, { "text": "Cocina ahora", "n": 4 }] },
    { "id": "create-user", "path": "/users", "click": ["Crear usuario"], "waitFor": "La persona recibe un enlace",
      "annotate": [{ "selector": "[role=dialog] input[type=email]", "n": 1 }, { "text": "Roles en esta cuenta", "n": 2 }, { "selector": "[role=dialog] button[type=submit]", "n": 3 }] },
    { "id": "operations-board", "path": "/operations", "waitFor": "Por confirmar",
      "annotate": [{ "selector": "[role=tablist]", "n": 1 }, { "selector": "ul[aria-label='Resumen de la operación']", "n": 2 }, { "text": "Por confirmar", "n": 3 }, { "text": "Nuevo pedido", "n": 4 }] },
    { "id": "new-order", "path": "/operations/{ORDER_PENDING}", "waitFor": "Confirmar pedido",
      "annotate": [{ "text": "Precio unitario", "n": 1 }, { "selector": "[aria-label='Sugerencias de observación']", "n": 2 }, { "text": "Total", "n": 3 }, { "text": "Confirmar pedido", "n": 4 }] },
    { "id": "dispatch", "path": "/operations?view=dispatch", "waitFor": "Listos para salir",
      "annotate": [{ "text": "De turno ahora", "n": 1 }, { "text": "Listos para salir", "n": 2 }, { "text": "En ruta", "n": 3 }] },
    { "id": "payment", "path": "/operations/{ORDER_UNPAID}", "click": ["Registrar pago"], "waitFor": "Confirmar pago",
      "annotate": [{ "text": "Pago pendiente", "n": 1 }, { "text": "Monto", "n": 2 }, { "selector": "[aria-label='Método de pago']", "n": 3 }, { "text": "Confirmar pago", "n": 4 }] },
    { "id": "kitchen-view", "path": "/operations?view=kitchen", "waitFor": "Preparando",
      "annotate": [{ "selector": "ul[aria-label='Resumen de la operación']", "n": 1 }, { "text": "Preparando", "n": 2 }, { "text": "Iniciar", "n": 3 }, { "selector": "button[aria-label='Más opciones']", "n": 4 }] },
    { "id": "stock", "path": "/supply/stock", "waitFor": "Insumos",
      "annotate": [{ "selector": "nav[aria-label] a[href$='/supply/stock']", "n": 1 }, { "text": "Bajo mínimo", "n": 2 }, { "selector": "[role=progressbar]", "n": 3 }, { "text": "Reponer", "n": 4 }] },
    { "id": "purchase", "path": "/supply/compras/{PURCHASE_DRAFT}", "waitFor": "Agregar línea",
      "annotate": [{ "text": "Último:", "n": 1 }, { "text": "Costo unitario", "n": 2 }, { "selector": "table", "n": 3 }, { "text": "Confirmar compra", "n": 4 }] },
    { "id": "menu-planner", "path": "/menu-planner", "waitFor": "Catálogo de platos",
      "annotate": [{ "text": "Catálogo de platos", "n": 1 }, { "selector": "[role=tablist]", "n": 2 }, { "text": "Copiar", "n": 3 }, { "text": "Arrastra un plato aquí", "n": 4 }] },
    { "id": "recipe", "path": "/recipes/{PRODUCT_WITH_RECIPE}", "waitFor": "Costo estimado",
      "annotate": [{ "text": "Receta —", "n": 1 }, { "selector": "table", "n": 2 }, { "text": "Costo estimado", "n": 3 }, { "text": "Guardar como nueva versión", "n": 4 }] },
    { "id": "customers", "path": "/customers", "waitFor": "Total clientes",
      "annotate": [{ "text": "Total clientes", "n": 1 }, { "selector": "input[aria-label='Buscar clientes']", "n": 2 }, { "selector": "[aria-label='Filtrar clientes']", "n": 3 }, { "text": "Nuevo cliente", "n": 4 }] },
    { "id": "insights", "path": "/insights", "waitFor": "Resumen del negocio",
      "annotate": [{ "selector": "[aria-label='Filtros de Insights'] select", "n": 1 }, { "text": "Comparar", "n": 2 }, { "selector": "nav[aria-label='Secciones de Insights'], [aria-label='Secciones de Insights']", "n": 3 }, { "text": "Ingresos", "n": 4 }, { "text": "Exportar CSV", "n": 5 }] },
    { "id": "copilot", "path": "/dashboard", "click": ["css=button[aria-label='Abrir Quanela Copilot']"],
      "fill": [{ "target": "css=textarea[aria-label='Pregunta para Copilot']", "text": "¿Cómo registro una compra?", "press": "Enter" }],
      "waitFor": "Centro de ayuda",
      "annotate": [{ "text": "¿Cómo registro una compra?", "n": 1 }, { "selector": "[role=dialog] [aria-live=polite] > div:nth-child(2)", "n": 2 }, { "text": "Centro de ayuda", "n": 3 }, { "selector": "button[aria-label='Buena respuesta']", "n": 4 }] }
  ]
}
